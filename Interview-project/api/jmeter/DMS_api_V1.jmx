            <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="BeanShell Assertion" enabled="false">
              <stringProp name="BeanShellAssertion.query">// Get the values of total1 and total2 variables
String total1 = vars.get(&quot;total1&quot;);
String total2 = vars.get(&quot;total2&quot;);
log.info(&quot;Total1: &quot; + total1);
log.info(&quot;Total2: &quot; + total2);

// Check if total1 and total2 are not null or empty
if (total1 != null &amp;&amp; !total1.isEmpty() &amp;&amp; total2 != null &amp;&amp; !total2.isEmpty()) {
    // Convert the variables to double and compare
    double num1 = Double.parseDouble(total1);
    double num2 = Double.parseDouble(total2);

    // Check if total1 is larger than total2
    if (num1 &gt; num2) {
        Failure = false;  // If total1 &gt; total2, the assertion passes
    } else {
        Failure = true;   // If total1 &lt;= total2, the assertion fails
        FailureMessage = &quot;total1 is not larger than total2&quot;;
    }
} else {
    Failure = true;  // If either total1 or total2 is null or empty, the assertion fails
    FailureMessage = &quot;One or both variables are null or empty&quot;;
}</stringProp>
              <stringProp name="BeanShellAssertion.filename"></stringProp>
              <stringProp name="BeanShellAssertion.parameters"></stringProp>
              <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
            </BeanShellAssertion>
