            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="resourceLink value Assertion" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def baseUrl = vars.get(&quot;baseUrl&quot;)
def resourceLink = vars.get(&quot;resourceLink&quot;)

if (resourceLink.contains(baseUrl)) {
    AssertionResult.setFailure(false)
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;The resource link does not contain the expected substring.&quot;)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor for nextVal" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
def highestVal = json.permission_types.max { it.val }.val

// Double the value of highestVal
def nextVal = highestVal * 2

// Assign nextVal to a JMeter variable
vars.put(&quot;nextVal&quot;, nextVal.toString())

// Log the value for verification (optional)
log.info(&quot;nextVal: &quot; + nextVal)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
